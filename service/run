#!/bin/sh
echo "*** starting dbus-power-watchdog ***"
exec 2>&1
. /etc/profile.d/profile.sh

# Brief delay on restart to allow D-Bus name release from previous instance
sleep 3

echo "Starting Power Watchdog discovery service..."
cd /data/apps/dbus-power-watchdog

# Plain python3: the service finds the shared BLE stack itself (ble_stack.py
# puts /data/bcm on sys.path and imports the connection manager before
# bleak), so nothing about how it was launched -- no interpreter shim, no
# PYTHONPATH, no environment contract -- decides which stack it runs on.
exec python3 -u dbus-power-watchdog.py
